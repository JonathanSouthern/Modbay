# ── AutoMod Studio environment variables ──
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must NEVER be committed.

# Anthropic Claude API (prompt engineering)
ANTHROPIC_API_KEY=
# Optional: override the Claude model used for prompt engineering
# CLAUDE_MODEL=claude-sonnet-4-5

# Google Gemini API (image editing)
GEMINI_API_KEY=
# Optional: override the Gemini image model
# GEMINI_MODEL=gemini-2.5-flash-image

# Clerk (auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Vercel KV / Upstash Redis (rate limiting)
KV_REST_API_URL=
KV_REST_API_TOKEN=
